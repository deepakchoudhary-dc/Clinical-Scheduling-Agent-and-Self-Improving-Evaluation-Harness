# Copy to `.env` and fill in. `.env` is gitignored -- never commit it.
#
# The harness reads the endpoint from CLINICAL_SCHEDULER_MODEL_ENDPOINT as a JSON
# object. A credential is referenced by the NAME of an environment variable
# (`api_key_env`), never inlined: config blobs get pasted into tickets, and a
# pasted blob must not carry a key.
#
# PowerShell:
#   $env:CLINICAL_SCHEDULER_MODEL_ENDPOINT = '{"provider":"ollama",...}'
#   & ".\.venv\Scripts\python.exe" -m clinical_scheduler.cli eval --suite core
#
# bash:
#   export CLINICAL_SCHEDULER_MODEL_ENDPOINT='{"provider":"ollama",...}'

# --- Ollama (local, no key) -------------------------------------------------
CLINICAL_SCHEDULER_MODEL_ENDPOINT={"provider":"ollama","base_url":"http://127.0.0.1:11434","model_id":"qwen2.5:7b-instruct"}

# --- llama.cpp (local, no key) ----------------------------------------------
# CLINICAL_SCHEDULER_MODEL_ENDPOINT={"provider":"llamacpp","base_url":"http://127.0.0.1:8080","model_id":"local-gguf"}

# --- OpenAI-compatible (hosted; key stays in its own variable) ---------------
# CLINICAL_SCHEDULER_MODEL_ENDPOINT={"provider":"openai_compatible","base_url":"https://api.openai.com/v1","model_id":"gpt-4o-mini","api_key_env":"OPENAI_API_KEY"}
# OPENAI_API_KEY=sk-replace-me

# --- Offline demonstration ---------------------------------------------------
# No endpoint is needed for the closed-loop demonstration, which uses a labelled
# loopback transport and a scripted generator:
#   & ".\.venv\Scripts\python.exe" scripts\demo_closed_loop.py --target ADV-11
